[10.000388, "o", "\r\u001b[32m✓\u001b[0m  攻撃パターンと脅威モデルを照合中...\r\n\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m 監査レポート: demo/vulnerable_app.py\u001b[0m\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n"]
[10.300783, "o", "\r\n  \u001b[31m\u001b[1m[CRITICAL]\u001b[0m \u001b[1mSQL インジェクション\u001b[0m\r\n  \u001b[2mLine 15\u001b[0m\r\n  ユーザー入力を直接 SQL クエリに結合しています。\r\n  攻撃例: username = \\\" ' OR '1'='1\\\" でログイン認証をバイパス可能。\r\n  \u001b[32m推奨修正:\u001b[0m parameterized query を使用してください。\r\n  \u001b[2mcursor.execute(\"SELECT * FROM users WHERE username=? AND password=?\",\u001b[0m\r\n  \u001b[2m              (username, password))\u001b[0m\r\n"]
[10.601123, "o", "\r\n  \u001b[31m\u001b[1m[CRITICAL]\u001b[0m \u001b[1mOS コマンドインジェクション\u001b[0m\r\n  \u001b[2mLine 24\u001b[0m\r\n  リクエストパラメータを shell=True で直接実行しています。\r\n"]
[10.601228, "o", "  攻撃例: cmd = \\\"ls; cat /etc/passwd\\\" で任意コマンド実行可能。\r\n  \u001b[32m推奨修正:\u001b[0m shell=False + リスト形式を使用し、入力を allowlist で検証。\r\n"]
[10.901329, "o", "\r\n  \u001b[31m[HIGH]\u001b[0m \u001b[1mパストラバーサル\u001b[0m\r\n  \u001b[2mLine 31\u001b[0m"]
[10.901656, "o", "\r\n  filename をサニタイズせず os.path.join に渡しています。\r\n  攻撃例: name=../../etc/passwd で任意ファイルを読み取り可能。\r\n  \u001b[32m推奨修正:\u001b[0m pathlib.Path.resolve() でベースパス外へのアクセスを禁止。\r\n"]
[11.201859, "o", "\r\n"]
[11.202547, "o", "  \u001b[31m[HIGH]\u001b[0m \u001b[1mハードコードされたシークレット\u001b[0m\r\n  \u001b[2mLine 9\u001b[0m\r\n  SECRET_KEY がソースコードに直書きされています。\r\n  Git 履歴にも残存するため、削除後も漏洩リスクが継続します。\r\n  \u001b[32m推奨修正:\u001b[0m 環境変数 or Vault 経由で注入してください。\r\n"]
[11.502551, "o", "\r\n"]
[11.503014, "o", "  \u001b[33m[MEDIUM]\u001b[0m \u001b[1mエラーメッセージへの情報漏洩\u001b[0m\r\n  \u001b[2mLine 17\u001b[0m\r\n"]
[11.503051, "o", "  認証失敗時に 'Invalid credentials' を返すと\r\n"]
[11.503098, "o", "  ユーザー名の存在確認（ユーザー列挙）に悪用される可能性があります。\r\n  \u001b[32m推奨修正:\u001b[0m 認証失敗の理由を統一したメッセージに。\r\n"]
[11.803554, "o", "\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m サマリー\u001b[0m\r\n\u001b[1m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m"]
[11.803954, "o", "\r\n"]
[12.103904, "o", "  \u001b[31m\u001b[1mCRITICAL\u001b[0m  2件  SQL Injection, Command Injection\r\n  \u001b[31mHIGH    \u001b[0m  2件  Path Traversal, Hardcoded Secret\r\n"]
[12.104161, "o", "  \u001b[33mMEDIUM  \u001b[0m  1件  Information Disclosure\r\n\r\n  リスクスコア: \u001b[31m\u001b[1m9.1 / 10\u001b[0m  \u001b[31m●●●●●●●●●○\u001b[0m\r\n\r\n  \u001b[2m⚠️  このレポートは人間による最終確認が必要です。\u001b[0m\r\n  \u001b[2m   詳細: redteam-scan --format sarif -o results.sarif\u001b[0m\r\n\r\n"]
[12.606933, "o", "\u001b[32m完了 \u001b[2m(3.2s)\u001b[0m\r\n\r\n"]
